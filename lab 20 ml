        "import pandas as pd\n",
        "\n",
        "data = [\n",
        "    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes']\n",
        "]\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "S = ['0'] * 6\n",
        "G = [['?', '?', '?', '?', '?', '?']]\n",
        "\n",
        "for row in data:\n",
        "    x = row[:-1]\n",
        "    label = row[-1]\n",
        "\n",
        "    if label == 'Yes':\n",
        "        for i in range(6):\n",
        "            if S[i] == '0':\n",
        "                S[i] = x[i]\n",
        "            elif S[i] != x[i]:\n",
        "                S[i] = '?'\n",
        "    else:\n",
        "        new_G = []\n",
        "        for g in G:\n",
        "            for i in range(6):\n",
        "                if g[i] == '?':\n",
        "                    if x[i] != S[i]:\n",
        "                        temp = g.copy()\n",
        "                        temp[i] = S[i]\n",
        "                        new_G.append(temp)\n",
        "        G = new_G\n",
        "\n",
        "print(\"Specific Boundary:\", S)\n",
        "print(\"General Boundary:\", G)"
